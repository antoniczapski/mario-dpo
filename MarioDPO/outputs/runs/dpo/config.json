{
  "sft_model": "models/sft",
  "output_dir": "models/dpo",
  "pairs_file": "data/synthetic/preference_pairs.jsonl",
  "max_length": 256,
  "beta": 0.1,
  "loss_type": "sigmoid",
  "learning_rate": 1e-05,
  "num_train_epochs": 3,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 8,
  "warmup_ratio": 0.1,
  "logging_steps": 20,
  "save_steps": 500,
  "seed": 42,
  "fp16": true,
  "use_lora": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05
}