# MarioDPO — secrets template.
# Copy to ".env" (which is gitignored) and fill in real values.
# NEVER commit the real .env. Tokens are read from the environment at runtime.

# HuggingFace access token (read scope is enough to pull the base checkpoint).
# Create at https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases API key for experiment tracking.
# Find at https://wandb.ai/authorize
WANDB_API_KEY=

# Optional: override the W&B project/entity used by the training scripts.
WANDB_PROJECT=pcg-mariodpo
# WANDB_ENTITY=

# Optional: set to "offline" to log W&B locally without network access,
# or "disabled" to turn W&B off entirely (the dummy run uses "disabled").
WANDB_MODE=online
